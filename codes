## ---- S10. Permutation tests (secondary) ---------------------------------------
## Exact: choose(14,6) = 3003 assignments, so every possible split is enumerated.
ALL_SPLITS <- combn(nrow(meta), N1, simplify = FALSE)
perm_p <- function(v) {
  obs <- mean(v[IDX_CTL]) - mean(v[IDX_ASD])
  nul <- vapply(ALL_SPLITS, function(s) mean(v[s]) - mean(v[-s]), numeric(1))
  (1 + sum(abs(nul) >= abs(obs)))/(1 + length(nul))
}
perm_tbl <- purrr::map_dfr(split(pairs_tbl, pairs_tbl$set), function(pp)
  tibble(set = unique(pp$set),
         p_unadjusted = perm_p(score_of(E_adj, pp)),
         p_composition_adjusted = perm_p(score_of(E_comp, pp))))
ct_perm <- purrr::map_dfr(names(CELLTYPE), function(k)
  tibble(cell_type = k, p_exact_perm = perm_p(meta[[k]])))
print(as.data.frame(perm_tbl)); print(as.data.frame(ct_perm))
