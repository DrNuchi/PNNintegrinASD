## =============================================================================
## 5. ECM-INTEGRIN COUPLING
##
## Coupling is the transcriptional co-regulation of a gene pair across donors.
## It is not evidence of heterodimer formation.
## =============================================================================
## Degradation is removed before correlating; design = ~condition preserves the
## group difference under test.
E_adj <- limma::removeBatchEffect(
  E, covariates = as.matrix(meta[, "degradation_index", drop = FALSE]),
  design = model.matrix(~ condition, meta))

cpm_m <- edgeR::cpm(counts(dds)); rownames(cpm_m) <- SYM
cpm_m <- cpm_m[rownames(E_adj), , drop = FALSE]
expressed <- rownames(cpm_m)[rowSums(cpm_m >= 1) >= N1]

pairs_tbl <- bind_rows(
  HD |> transmute(set = "alpha_beta", label = dimer, A = alpha, B = beta),
  tidyr::expand_grid(A = c("ACAN","BCAN","NCAN","VCAN","TNR","HAPLN1"),
                     B = c("ITGB1","ITGB3","ITGAV","ITGA5","CD44","PTPRZ1")) |>
    transmute(set = "pnn_receptor", label = paste0(A, ":", B), A, B)) |>
  filter(A %in% expressed, B %in% expressed, A != B)

## Per-donor coupling score: the mean cross-product of the two partners'
## within-cohort z-scores. Unlike a correlation this is defined per subject, so
## it can be given an effect size and adjusted for composition.
score_of <- function(M, pp) { Z <- t(scale(t(M)))
colMeans(Z[pp$A, ] * Z[pp$B, ], na.rm = TRUE) }

g_boot <- function(v, B = 5000) {
  a <- v[IDX_ASD]; b <- v[IDX_CTL]
  pooled_sd <- function(x, y)
    sqrt(((length(x)-1)*var(x) + (length(y)-1)*var(y))/(length(x)+length(y)-2))
  g <- (mean(a) - mean(b)) / pooled_sd(a, b) * J
  ## NOTE: sample(x, TRUE) passes TRUE as the SIZE argument, not replace, and
  ## errors. The size must be given explicitly for a case resampling bootstrap.
  bs <- replicate(B, {
    ai <- sample(a, length(a), replace = TRUE)
    bi <- sample(b, length(b), replace = TRUE)
    s  <- pooled_sd(ai, bi)
    if (!is.finite(s) || s == 0) NA_real_ else (mean(ai) - mean(bi)) / s * J
  })
  if (all(is.na(bs))) return(c(g = g, lo = NA_real_, hi = NA_real_))
  c(g = g, lo = unname(quantile(bs, .025, na.rm = TRUE)),
    hi = unname(quantile(bs, .975, na.rm = TRUE)))
}

## ---- Composition adjustment (cell-type marker scores) -----------------------
Zc <- t(scale(t(E)))
ct <- as.data.frame(vapply(CELLTYPE, function(g) {
  g <- intersect(g, rownames(Zc)); colMeans(Zc[g, , drop = FALSE], na.rm = TRUE)
}, numeric(ncol(E))))
meta <- cbind(meta, ct[match(meta$sample_id, rownames(ct)), ])
E_comp <- limma::removeBatchEffect(
  E_adj, covariates = as.matrix(meta[, names(CELLTYPE)]),
  design = model.matrix(~ condition, meta))

coupling <- purrr::map_dfr(split(pairs_tbl, pairs_tbl$set), function(pp) {
  v0 <- score_of(E_adj, pp); v1 <- score_of(E_comp, pp)
  a <- g_boot(v0); b <- g_boot(v1)
  tibble(set = unique(pp$set), n_pairs = nrow(pp),
         mean_CTL = mean(v0[IDX_CTL]), mean_ASD = mean(v0[IDX_ASD]),
         g = a["g"], g_lo = a["lo"], g_hi = a["hi"],
         g_compadj = b["g"], g_compadj_lo = b["lo"], g_compadj_hi = b["hi"])
})
print(as.data.frame(coupling)); wr(coupling, "T3_coupling_effect_sizes")

## Cell-type differences, reported so the composition adjustment is interpretable
ct_est <- purrr::map_dfr(names(CELLTYPE), function(k) {
  r <- g_boot(meta[[k]]); tibble(cell_type = k, g = r["g"], lo = r["lo"], hi = r["hi"])
})
print(as.data.frame(ct_est)); wr(ct_est, "S4_celltype_effect_sizes")

## ---- FIGURE 3: coupling, per donor and after composition adjustment ---------
sc_long <- purrr::map_dfr(split(pairs_tbl, pairs_tbl$set), function(pp)
  tibble(set = unique(pp$set), sample_id = colnames(E_adj),
         condition = meta$condition,
         Unadjusted = score_of(E_adj, pp),
         `Composition-adjusted` = score_of(E_comp, pp))) |>
  tidyr::pivot_longer(c(Unadjusted, `Composition-adjusted`),
