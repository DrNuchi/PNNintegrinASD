         mean_g_lo = mean(e$hedges_g) - 1.96*se,
         mean_g_hi = mean(e$hedges_g) + 1.96*se,
         n_large_effect = sum(abs(e$hedges_g) >= SESOI),
         p_sign = binom.test(sum(e$hedges_g > 0), nrow(e))$p.value)
})
