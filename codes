IDX_ASD <- which(meta$condition == "ASD"); N2 <- length(IDX_ASD)


## =============================================================================
## 4. EFFECT SIZES
##
## Hedges g (Cohen's d with the small-sample correction) with 95% intervals.
## p-values are retained as a secondary column only.
## =============================================================================
dds  <- DESeq(dds, fitType = "parametric", quiet = TRUE)
r0   <- results(dds, contrast = c("condition","ASD","CTL"))
dfree <- N1 + N2 - 2
J     <- 1 - 3/(4*dfree - 1)
K     <- sqrt(1/N1 + 1/N2)

est <- as.data.frame(r0) |> tibble::rownames_to_column("gene_id") |>
  mutate(symbol = SYM[match(gene_id, rownames(dds))],
         sd_within = lfcSE / K,
         hedges_g  = (log2FoldChange / sd_within) * J,
         se_g      = sqrt((N1+N2)/(N1*N2) + (hedges_g/J)^2/(2*(N1+N2))) * J,
         g_lo = hedges_g - 1.96*se_g, g_hi = hedges_g + 1.96*se_g,
         magnitude = case_when(abs(hedges_g) >= 1.2 ~ "very large",
                               abs(hedges_g) >= 0.8 ~ "large",
                               abs(hedges_g) >= 0.5 ~ "medium",
                               TRUE                 ~ "small")) |>
  filter(!is.na(hedges_g)) |> arrange(desc(abs(hedges_g)))
wr(est |> filter(symbol %in% INTEGRISOME) |>
     select(symbol, baseMean, log2FoldChange, hedges_g, g_lo, g_hi, magnitude, pvalue),
   "S2_integrisome_effect_sizes_all_genes")

## ---- Panel-level effect sizes (Finding 1) -----------------------------------
panels <- list(Matrisome = MATRISOME_ALL, Collagens = COLLAGENS,
               `ECM proteases` = PROTEASES, `Perineuronal net` = PNN,
               Adhesome = ADHESOME, `Integrin subunits` = INTEGRINS,
               `Integrin alpha` = INTEGRIN_A, `Integrin beta` = INTEGRIN_B)
panel_est <- purrr::imap_dfr(panels, function(gs, nm) {
  e <- est |> filter(symbol %in% gs)
  if (nrow(e) < 5) return(NULL)
  se <- sd(e$hedges_g)/sqrt(nrow(e))
  tibble(panel = nm, n_genes = nrow(e), n_up = sum(e$hedges_g > 0),
         mean_g = mean(e$hedges_g), lo = mean_g - 1.96*se, hi = mean_g + 1.96*se,
         excludes_zero = lo > 0 | hi < 0,
         n_large = sum(abs(e$hedges_g) >= SESOI))
}) |> arrange(desc(mean_g))
print(as.data.frame(panel_est)); wr(panel_est, "T1_panel_effect_sizes")

## Panels are additionally compared with length-matched background genes,
## because ECM transcripts are unusually long and the ASD libraries are
## marginally more degraded.
glen <- rowMeans(SummarizedExperiment::assays(dds)[["avgTxLength"]])
est$len <- glen[match(est$gene_id, names(glen))]
est$bin <- cut(est$len, quantile(est$len, seq(0,1,.1), na.rm = TRUE),
               include.lowest = TRUE)
bg <- est |> filter(!symbol %in% c(MATRISOME_ALL, INTEGRINS, PROTEASES, PNN))
len_null <- purrr::imap_dfr(panels[c("Matrisome","Collagens","Integrin subunits")],
                            function(gs, nm) {
                              i <- which(est$symbol %in% gs); if (length(i) < 5) return(NULL)
                              obs <- mean(est$hedges_g[i])
                              nul <- replicate(2000, mean(vapply(est$bin[i], function(b) {
                                p <- which(bg$bin == b)
                                if (!length(p)) NA_real_ else bg$hedges_g[sample(p, 1)] }, numeric(1)),
                                na.rm = TRUE))
                              pe <- panel_est[panel_est$panel == nm, ]
                              tibble(panel = nm, n_genes = length(i),
                                     observed_mean_g = obs,
                                     observed_lo = if (nrow(pe)) pe$lo else NA_real_,
                                     observed_hi = if (nrow(pe)) pe$hi else NA_real_,
                                     null_mean_g = mean(nul),
                                     null_lo = quantile(nul, .025), null_hi = quantile(nul, .975),
                                     p_vs_length_matched = (1 + sum(abs(nul) >= abs(obs)))/(1 + length(nul)))
                            })
print(as.data.frame(len_null)); wr(len_null, "S3_length_matched_background")

