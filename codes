## ---- S9. Leave-one-donor-out stability of the coupling result ----------------
loo <- purrr::map_dfr(split(pairs_tbl, pairs_tbl$set), function(pp) {
  purrr::map_dfr(seq_len(nrow(meta)), function(i) {
    k <- setdiff(seq_len(nrow(meta)), i); g <- meta$condition[k]
    if (min(table(g)) < 4) return(NULL)
    v <- score_of(E_adj[, k], pp); a <- v[g == "ASD"]; b <- v[g == "CTL"]
    sp <- sqrt(((length(a)-1)*var(a) + (length(b)-1)*var(b))/(length(a)+length(b)-2))
    tibble(set = unique(pp$set), dropped = meta$sample_id[i],
           g = (mean(a) - mean(b))/sp * J)
  })
})
loo_sum <- loo |> group_by(set) |>
  summarise(min_g = min(g), max_g = max(g), median_g = median(g),
            n_runs_large = sum(abs(g) >= SESOI), n_runs = n())
print(as.data.frame(loo_sum)); wrs(loo, "S9_leave_one_out"); wrs(loo_sum, "S9_leave_one_out_summary")

## ---- S11. Per-pair correlations underlying the coupling scores ---------------
se_dz <- sqrt(1/(N1 - 3) + 1/(N2 - 3))
fz    <- function(r) 0.5 * log((1 + r) / (1 - r))
clamp <- function(r, eps = 1e-6) pmin(pmax(r, -1 + eps), 1 - eps)
safe_cor <- function(x, y) {
  if (sd(x) == 0 || sd(y) == 0 || !is.finite(sd(x)) || !is.finite(sd(y)))
    return(NA_real_)
  suppressWarnings(cor(x, y, method = "spearman"))
}
per_pair <- purrr::pmap_dfr(
  list(pairs_tbl$set, pairs_tbl$label, pairs_tbl$A, pairs_tbl$B),
  function(s, lab, a, b) {
    r1 <- safe_cor(E_adj[a, IDX_CTL], E_adj[b, IDX_CTL])
    r2 <- safe_cor(E_adj[a, IDX_ASD], E_adj[b, IDX_ASD])
    dz <- fz(clamp(r2)) - fz(clamp(r1))
    tibble(set = s, pair = lab, gene_A = a, gene_B = b,
           rho_CTL = r1, rho_ASD = r2, delta_rho = r2 - r1,
           delta_z = dz, delta_z_lo = dz - 1.96*se_dz, delta_z_hi = dz + 1.96*se_dz,
           sign_reversal = !is.na(r1) & !is.na(r2) & sign(r1) != sign(r2) &
             abs(r1) > 0.3 & abs(r2) > 0.3)
  }) |> arrange(delta_z)
print(as.data.frame(head(per_pair, 12))); wrs(per_pair, "S11_coupling_per_pair")
message(sprintf("S11: %d of %d pairs reverse sign between groups",
                sum(per_pair$sign_reversal, na.rm = TRUE), nrow(per_pair)))

