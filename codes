## 3. RNA DEGRADATION COVARIATE
##
## RIN could not be joined to individual libraries, so degradation is measured
## from the quantifications themselves: degraded RNA loses long transcripts
## first, so the read-weighted mean transcript length falls.
## =============================================================================
deg <- purrr::map_dfr(SAMPLES, function(s) {
  q <- fread(files[s], select = c("Length","NumReads"))[NumReads > 0]
  tot <- sum(q$NumReads)
  tibble(sample_id = s,
         wt_len   = sum(q$Length * q$NumReads) / tot,
         frac_4kb = sum(q$NumReads[q$Length > 4000]) / tot,
         frac_1kb = sum(q$NumReads[q$Length < 1000]) / tot)
})
di <- prcomp(scale(deg[, c("wt_len","frac_4kb","frac_1kb")]))$x[, 1]
if (cor(di, deg$wt_len) > 0) di <- -di
deg$degradation_index <- as.numeric(scale(di))
meta <- as.data.frame(left_join(meta, deg, by = "sample_id"))
rownames(meta) <- meta$sample_id
stopifnot(!any(is.na(meta$degradation_index)))
wr(meta, "S1_sample_metadata_QC")

SummarizedExperiment::colData(dds) <- S4Vectors::DataFrame(meta, row.names = SAMPLES)
design(dds) <- ~ degradation_index + condition
vsd <- vst(dds, blind = FALSE)
