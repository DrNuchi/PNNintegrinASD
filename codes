## ---- S6. Precision and exaggeration ------------------------------------------
prec <- tibble(median_CI_width_g = median(est$g_hi - est$g_lo, na.rm = TRUE),
               n_CTL = N1, n_ASD = N2)
se_g0 <- function(d) sqrt((N1+N2)/(N1*N2) + d^2/(2*(N1+N2))) * J
set.seed(SEED)
retro <- purrr::map_dfr(c(0.2,0.3,0.5,0.8,1.0,1.2), function(td) {
  s <- se_g0(td)/J; crit <- qt(.975, dfree)*s
  e <- rnorm(2e5, td, s); sig <- abs(e) > crit
  tibble(assumed_true_d = td, power = mean(sig),
         type_S = mean(sign(e[sig]) != sign(td)),
         exaggeration_type_M = mean(abs(e[sig]))/abs(td))
})
print(as.data.frame(prec)); print(as.data.frame(retro))
wrs(prec, "S6a_precision"); wrs(retro, "S6b_type_M_S")

