## tx2gene from the transcript FASTA that built the Salmon index. Its headers
## carry gene id, symbol and biotype, so the map is complete by construction.
hdr <- grep("^>", readLines(gzfile(FASTA_PATH, "rt")), value = TRUE)
fld <- function(x, key) {                 # length-preserving field extractor
  rx <- regexpr(paste0("(?:^|\\s)", key, ":\\S+"), x, perl = TRUE)
  out <- rep(NA_character_, length(x)); ok <- rx > 0
  out[ok] <- sub(paste0("^\\s*", key, ":"), "",
                 substring(x[ok], rx[ok], rx[ok] + attr(rx,"match.length")[ok] - 1L))
  out
}
t2g <- data.frame(TXNAME = strip_ver(sub("^>([^ ]+).*", "\\1", hdr)),
                  GENEID = strip_ver(fld(hdr, "gene")),
                  SYMBOL = fld(hdr, "gene_symbol"),
                  BIOTYPE = fld(hdr, "gene_biotype")) |>
  filter(!is.na(TXNAME), !duplicated(TXNAME))

txi <- tximport(files, type = "salmon", tx2gene = t2g[, c("TXNAME","GENEID")],
                ignoreTxVersion = TRUE)

