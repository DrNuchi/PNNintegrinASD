tidy_ci <- function(d) {
  d  <- as.data.frame(d)
  nm <- names(d)
  
  nm <- sub("^null_lo$", "null_percentile_2.5",  nm)
  nm <- sub("^null_hi$", "null_percentile_97.5", nm)
  nm <- sub("^lo$",   "CI95_lower", nm)
  nm <- sub("^hi$",   "CI95_upper", nm)
  nm <- sub("_lo$",   "_CI95_lower", nm)
  nm <- sub("_hi$",   "_CI95_upper", nm)
  names(d) <- nm
  d
}
wr  <- function(d, n) fwrite(tidy_ci(d), file.path(OUT, paste0(n, ".csv")))
